<%
const safe = value => value == null ? '' : String(value);
const issueRecord = typeof issue === 'object' && issue ? issue : {};
const newsletterRecord = typeof newsletter === 'object' && newsletter ? newsletter : {};
const content = issueRecord.content || {};
const sourceItems = Array.isArray(issueRecord.sources) ? issueRecord.sources.filter(Boolean) : [];
const podcastItems = sourceItems.filter(item => item.type === 'podcast');
const resourceItems = sourceItems.filter(item => item.type === 'offering' || item.type === 'shop');
const darrenNote = content.darrenNote || null;
const upcoming = content.upcoming || null;
const period = issueRecord.period || {};
const displayDate = value => {
    if (!value) return '';
    const dateValue = new Date(`${safe(value).slice(0, 10)}T00:00:00Z`);
    return Number.isNaN(dateValue.getTime()) ? safe(value) : new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' }).format(dateValue);
};
const lastDay = period.end ? new Date(`${safe(period.end).slice(0, 10)}T00:00:00Z`) : null;
if (lastDay && !Number.isNaN(lastDay.getTime())) lastDay.setUTCDate(lastDay.getUTCDate() - 1);
const periodLabel = [displayDate(period.start), lastDay ? displayDate(lastDay.toISOString().slice(0, 10)) : ''].filter(Boolean).join(' – ');
const issueTitle = safe(content.title || issueRecord.title || newsletterRecord.name || 'Community newsletter');
const pageRecord = {
    ...(page || {}),
    title: safe((page && page.title) || `${issueTitle}${periodLabel ? ` | ${periodLabel}` : ''}`),
    description: safe((page && page.description) || content.previewText || newsletterRecord.description || ''),
    canonical: safe((page && page.canonical) || issueRecord.website?.url || ''),
    noindex: issueRecord.editorial?.status !== 'approved'
};
%>
<%- include(`${baseDir}/${lang.id}/header.html`, { page: pageRecord, lang }) %>

<main id="content" class="newsletter-archive" style="max-width: 820px; margin: 0 auto; padding: 2rem 1.25rem;">
    <header class="newsletter-header" style="margin-bottom: 2rem;">
        <p class="newsletter-period" style="color: #526579; font-weight: 600;">
            <%= periodLabel %>
        </p>
        <h1><%= issueTitle %></h1>
        <% if (content.previewText) { %>
            <p class="newsletter-preview" style="font-size: 1.2rem; color: #40566b;"><%= content.previewText %></p>
        <% } %>
        <% if (content.opening) { %>
            <div class="newsletter-opening"><p><%= content.opening %></p></div>
        <% } %>
    </header>

    <% if (darrenNote) { %>
        <section aria-labelledby="newsletter-darren-note" class="newsletter-darren-note" style="background:#f3f7fa;padding:1.25rem 1.5rem;margin:1.5rem 0;border-left:4px solid #0878a5;">
            <h2 id="newsletter-darren-note">A note from Darren</h2>
            <% safe(darrenNote.text).split(/\n\n+/).filter(Boolean).forEach(paragraph => { %>
                <p><%= paragraph %></p>
            <% }); %>
            <% if (Array.isArray(darrenNote.publicLinks) && darrenNote.publicLinks.length) { %>
                <nav aria-label="Links from Darren's note" style="display:flex;gap:1rem;flex-wrap:wrap;">
                    <% darrenNote.publicLinks.forEach(link => { %>
                        <a href="<%= safe(link.url) %>"><%= safe(link.label) %></a>
                    <% }); %>
                </nav>
            <% } %>
        </section>
    <% } %>

    <% if (podcastItems.length) { %>
        <section aria-labelledby="newsletter-podcasts">
            <h2 id="newsletter-podcasts">From the podcasts</h2>
            <% podcastItems.forEach(item => { const links = item.links || {}; %>
                <article class="newsletter-item" style="border-bottom: 1px solid #d9e0e7; padding: 1rem 0;">
                    <h3><%= safe(item.title) %></h3>
                    <% if (item.summary) { %><p><%= item.summary %></p><% } %>
                    <% if (item.whyItMatters) { %><p><%= item.whyItMatters %></p><% } %>
                    <nav aria-label="Podcast links" style="display: flex; gap: 1rem; flex-wrap: wrap;">
                        <% if (links.blog || item.url) { %><a href="<%= safe(links.blog || item.url) %>">Read the blog</a><% } %>
                        <% if (links.youtube) { %><a href="<%= safe(links.youtube) %>">Watch on YouTube</a><% } %>
                        <% if (links.audio) { %><a href="<%= safe(links.audio) %>">Listen to the audio</a><% } %>
                    </nav>
                </article>
            <% }); %>
        </section>
    <% } %>

    <% if (resourceItems.length) { %>
        <section aria-labelledby="newsletter-resources" style="margin-top: 2rem;">
            <h2 id="newsletter-resources">New resources</h2>
            <% resourceItems.forEach(item => { const links = item.links || {}; const resourceUrl = links.resource || links.shop || item.url; %>
                <article class="newsletter-item" style="border-bottom: 1px solid #d9e0e7; padding: 1rem 0;">
                    <h3><%= safe(item.title) %></h3>
                    <% if (item.summary) { %><p><%= item.summary %></p><% } %>
                    <% if (item.whyItMatters) { %><p><%= item.whyItMatters %></p><% } %>
                    <% if (resourceUrl) { %><p><a href="<%= safe(resourceUrl) %>">Explore this resource</a></p><% } %>
                </article>
            <% }); %>
        </section>
    <% } %>

    <% if (upcoming && upcoming.text) { %>
        <section aria-labelledby="newsletter-upcoming" style="margin-top:2rem;">
            <h2 id="newsletter-upcoming">Coming up</h2>
            <p><%= safe(upcoming.text) %></p>
        </section>
    <% } %>

    <% if (darrenNote && darrenNote.communityQuestion) { %>
        <section aria-labelledby="newsletter-community-question" style="margin-top:2rem;padding:1rem 1.25rem;background:#eef5f8;">
            <h2 id="newsletter-community-question">Join the conversation</h2>
            <p><%= safe(darrenNote.communityQuestion) %></p>
        </section>
    <% } %>

    <% if (!podcastItems.length && !resourceItems.length && !darrenNote) { %>
        <p>This issue has no published items.</p>
    <% } %>

    <% if (content.closing) { %>
        <section class="newsletter-closing" style="margin-top: 2rem;">
            <h2>Stay connected</h2>
            <p><%= content.closing %></p>
        </section>
    <% } %>
</main>

<%- include(`${baseDir}/${lang.id}/footer.html`, { page: pageRecord, lang }) %>
